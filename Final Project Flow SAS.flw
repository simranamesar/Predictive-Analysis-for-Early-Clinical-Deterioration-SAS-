,"UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false","UI_PROP_LOCATION":"355 27","UI_PROP_OUTPUT_PORT|outTable|0":"|Output table|Output table for the \"Calculate columns\" step."},"arguments":{"calculateColumns":[{"_uuid":"46aa4c1d-f52a-4792-ac61-d8cc68ae1a2c","expressionText":"ifc(missing(age), 'Missing',\n    ifc(age < 40, 'Under 40',\n        ifc(age < 60, '40-59',\n            ifc(age < 80, '60-79', '80+'))))","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"age_group","rawLength":8,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"361f1fb3-dc52-4a56-93ee-fbcb6038ec3b","expressionText":"ifc(missing(comorbidity_index), 'Missing',\n    ifc(comorbidity_index <= 1, 'Low',\n        ifc(comorbidity_index <= 3, 'Medium',\n            ifc(comorbidity_index <= 6, 'High', 'Very High'))))","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"comorbidity_group","rawLength":10,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"310d62f1-ef7a-4b70-8cb8-d79cc217eecf","expressionText":"ifc(missing(baseline_risk_score), 'Missing',\n    ifc(baseline_risk_score < 0.33, 'Low Risk',\n        ifc(baseline_risk_score < 0.66, 'Medium Risk', 'High Risk')))","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"baseline_risk_group","rawLength":12,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"e6ef092c-71a6-49e0-a4e3-9ac1f5d03b52","expressionText":"ifc(deterioration_event = 1, 'Deteriorated', 'No Deterioration')","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"deterioration_status","rawLength":20,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"a70345b8-faa1-4b33-ba61-86f4e71349fa","expressionText":"ifc(deterioration_within_12h_from_ad = 1, 'Early Deterioration', 'Not Early')","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"early_deterioration_status","rawLength":20,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"4e991af1-7894-4bd4-9ef2-41deba10f072","expressionText":"ifc(deterioration_event = 0, 'No Event',\n    ifc(deterioration_hour < 12, '0-12h',\n        ifc(deterioration_hour < 24, '12-24h',\n            ifc(deterioration_hour < 48, '24-48h', '48h+'))))","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"time_to_deterioration_group","rawLength":20,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"7d17ab99-344b-4c92-a7f6-ddb9679d25cd","expressionText":"(age >= 60)\n+ (age >= 80)\n+ (comorbidity_index >= 4)\n+ (comorbidity_index >= 7)\n+ (admission_type = \"Transfer\")\n+ (baseline_risk_score >= 0.33)\n+ (baseline_risk_score >= 0.66)","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"risk_points","rawLength":8,"type":"Numeric","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"7470c6f0-d27a-4699-a14a-f880d02a0eac","expressionText":"ifc(risk_points <= 2, 'Low Priority',\n    ifc(risk_points <= 4, 'Medium Priority', 'High Priority'))","operation":"expression","outColumn":{"columnDefinition":{"formattedLength":0,"index":0,"name":"risk_segment","rawLength":20,"type":"Char","version":1},"outputPort":"outTable","outputPortIndex":0,"referenceType":"columnDefinition","version":1}},{"_uuid":"6845b7d0-9b1a-42bf-ba2b-51bdff911fc0","expressionText":"ifn(risk_segment = 'Low Priority', 1